  "method": {
    "registration": "phaseCorrelate on fixed-background bounding rectangle after mean removal and Hanning window; translate second frame back; report response/shift, flag low-response/large shift",
    "photometric": "Subtract only median gray offset on fixed background",
    "difference": "Absolute grayscale difference on registered, background-bias-corrected frames; contemporaneous fixed-background q99 reference (minimum one 8-bit gray level)",
    "flow": "Farneback dense local optical flow (.5,3,19,3,5,1.2,0); magnitude / scale / actual adjacent audit-time dt; original-cache image px/s, not m/s",
    "activity": "Fractions above own-pair fixed-background q99; also joint gray+flow excess. Never class probabilities.",
    "qc": "Invalid diagnostic if gap>4.5 s, gray texture RMS<1, saturated/flat frame, phase response<.15, shift>12 original-cache pixels. Operational QC only, no semantic U or cut.",
    "rois": "Hand-drawn per camera; top timestamp and lower site OSD explicitly excluded; 5x5 processed erosion before summaries; fixed background separate from channel",
    "review_alert": "Descriptive old-T review trigger at >=20 s (roughly 10 cached pairs): either consecutive channel-joint activity <= background-joint, or median joint activity <= background-joint across that interval. Duration is a review choice, not a semantic or geological threshold. Does not imply all instants stationary.",
    "roi_validation": "Polygons checked against actual v1_96/v1_91 cached images; orange sampling ROI includes some bed and cyan fixed patch may differ in texture/noise. Always inspect the ROI contacts.",
    "boundary_alert": "For declared short windows on opposite P/T sides, record central 80% joint-activity ranges; overlap is a review alert only, no equivalence test and no semantic classification."
  },
  "limitations": [
    "Sparse roughly 2-second cached frames can miss short pulses completely; cannot authenticate continuity between cached frames.",
    "Dense flow over roughly 2 s may alias or underestimate water/material displacement; original-cache px/s is a diagnostic image displacement rate, not physical fluid speed.",
    "Manual channel polygons include some stationary bed and may miss thin moving threads; inspect ROI contact sheets.",
    "Motion cannot distinguish ordinary water from debris flow and absence of measured motion does not prove semantic N.",
    "Controls inherit existing working N/P; no new independent geological or semantic certification.",
    "Labels are contextual old working intervals only, and are not changed by this tool.",
    "Times are cached frames_index audit times; OSD and original PTS are not registered here.",
    "Only requested v1_91/v1_96 plus bounded v1_95/v1_98 controls are read; no original video is decoded."
  ],
